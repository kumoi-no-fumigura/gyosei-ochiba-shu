  {
   "id": "zokukagaku12-gyosei-ochiba-0010",
   "pid": "993390",
   "pages": [
    75
   ],
   "text": "進落",
   "poems": [],
   "lb": []
  }
 ],
 "poems": [
  {
   "seq": "1",
   "text": "鳩比杖つく〓〓見れバ昔わグ土筆つみつる野邊にぞ有りる",
   "kana": "",
   "speaker": "",
   "page": 66,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "春風のふくといもれと糸やなぎ亂るゝほどい靡りざりろり",
   "kana": "",
   "speaker": "",
   "page": 66,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "とグ門にたてる靑柳西におみ片よるひとのこゝろにも似老",
   "kana": "",
   "speaker": "",
   "page": 66,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "香をのみと契りしものを春風のたグへおたるり梅の花ちる",
   "kana": "",
   "speaker": "",
   "page": 66,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "梅比花さかぬ垣ねぞなろりける春い野末をゆくべかりりり",
   "kana": "",
   "speaker": "",
   "page": 66,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "人の世の春ともみえぬ法の庭にあらかむばしき梅此はつ花",
   "kana": "",
   "speaker": "",
   "page": 66,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "とけりねしありの手桶のうも氷うもらさむしな春のあさ風",
   "kana": "",
   "speaker": "",
   "page": 66,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "たれとても同じ佛れこ松原みちびくまゝにみちびうれてむ",
   "kana": "",
   "speaker": "",
   "page": 66,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "若水い名のみなりけり汲てみれバ翁さびたるかげぞ移れる",
   "kana": "",
   "speaker": "",
   "page": 66,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "梓ゆみやそぢの上にまた一ついらぬよはひを重ねつるうな",
   "kana": "",
   "speaker": "",
   "page": 66,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "さくら花匂ふ吉野の山ならら我みほとけにたてまつらばや",
   "kana": "",
   "speaker": "",
   "page": 67,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "よの塵と思ひまてゝもちらぬまいいとはれがたき花の下蔭",
   "kana": "",
   "speaker": "",
   "page": 67,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "心なき嵐もふうぞひともこぞ今日こそ花いみるべりりけれ",
   "kana": "",
   "speaker": "",
   "page": 67,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "花にのみりゝる心のうも雲をふきはらはずや春のやまかぜ",
   "kana": "",
   "speaker": "",
   "page": 67,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "たはあらぬ春の日數にうれしくもけふい花みて暮しつる哉",
   "kana": "",
   "speaker": "",
   "page": 67,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "墨田川岸のさくらのひとつ二つちりそめたるや盛なるらむ",
   "kana": "",
   "speaker": "",
   "page": 67,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "花みれバ思ひもてたる古里の春もさもグになつりしきのを",
   "kana": "",
   "speaker": "",
   "page": 67,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "思ふにいまりせぬ春の山風に今年もはやくちるさくらあな",
   "kana": "",
   "speaker": "",
   "page": 67,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "玄きみつむ袖の上にも花ぞちる櫻らりもとひとや見るらむ",
   "kana": "",
   "speaker": "",
   "page": 67,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "此春いはなより花に旅ねして家路をさへにわもれけるあな",
   "kana": "",
   "speaker": "",
   "page": 67,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "めでて見る人もあらを田すきかへしもきかへを間に花やちるらむ",
   "kana": "",
   "speaker": "",
   "page": 67,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "時鳥まつより外いよのおりおおもふことなきセグあゝろ哉",
   "kana": "",
   "speaker": "",
   "page": 67,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "時鳥聲きくごとにはこね山をきてわりれし人をしぞおもふ",
   "kana": "",
   "speaker": "",
   "page": 67,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "おくれじと思ひなグらもくらべ馬おそきやか比ら心なるらむ",
   "kana": "",
   "speaker": "",
   "page": 67,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "玄うりとて是もあらぞバ荒ちをグ身のともしさをいうおしてまし",
   "kana": "",
   "speaker": "",
   "page": 67,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "身をてらも光もあるを夏虫比など暗にのみまよひゆくらむ",
   "kana": "",
   "speaker": "",
   "page": 67,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "よの中をうしろぐらくいすまじとや夜を照してもとぶ螢哉",
   "kana": "",
   "speaker": "",
   "page": 67,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "たをらばやさをらバ人やとグめなむ籬まぢうき姫ゆり比花",
   "kana": "",
   "speaker": "",
   "page": 67,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "かくばりりにごりに濁るよ比中の花ともみえぬ蓮葉のはを",
   "kana": "",
   "speaker": "",
   "page": 67,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "せめていとはちもの花を植てみれど似ぬい心比濁なりけり",
   "kana": "",
   "speaker": "",
   "page": 67,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "はちも葉比露ばりりだによのなりの濁に玄まぬ心ともグを",
   "kana": "",
   "speaker": "",
   "page": 67,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "いぶせさを誰にかこたむ蚊遣火も己グたてさる烟なりけり",
   "kana": "",
   "speaker": "",
   "page": 67,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "お比きありお化きむせびて山賤グ眞柴いぶせき宵の蚊遣火",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "世おもめバ同じこゝろにさゝグにの蛛も願比糸やかくらむ",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "恨めるも招くもありてまぼろしの夢野に匂ふを花くぞはな",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "かたぶきし軒端比月いもりなグら壁にひまなき蟋蟀のこゑ",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "あはれよの人の心の野分をもきのふになしてみる由もらな",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "いなづませほ比めくひまの世中を千年と祈る人もありけり",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "むさし野のもゑ野の秋比艸の庵にやどるハ露と我とえけり",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "かりの世ぞかり比宿りぞかり北身ぞとばろり雁の鳴渡るらむ",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "やグてしもいづらむ月を山の端のまつい久しき物にざりける",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "さし出るかたわれ月よ我もまたれなじ程にもよい更にけり",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "諸共に山の奥にいさみもせでこいいづこにう月の入るらん",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "さらにまた心細くも見ゆるうな旅路のあきの三日月のりゆ",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "むらさめのなごりの雫かゞやきて竹比は山に月さしのぼる",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "旅にねて夜出きぬた比音きけバ一つ〓〓にあなしりりりり",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "いくたびり法比時雨ああひなグらそまるにうもきわグ心哉",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "かりはてゝ鳥もあさらぬ小山田の風に鳴子の音のさびしさ",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "虫なきて尾花みだれてわグいほい今も昔比むさし野比はら",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "時雨にも露にもぬれていく千度いくその峯を回りきぬらむ",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "をり〓〓いはるゝ時雨の山里にやまぬい庭の落葉なりけり",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "夕月のりどに亂れてかはほりのかりるグ如くちる木葉りな",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "冬がれの木立に似たる我身りなおちば一つも殘らざりりり",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "もみぢ葉北ちりし梢い音たえて松にやどれるこグらしの風",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "やグてこそ消ゆべきものを霜の上に何しろ人の跡殘すらむ",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "くるぞゝの袖につゝめる煩惱も碎りよとふる玉あられあな",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "かりそめにふける板や北玉霞いたくなうちそ碎りもやせむ",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "大原やもみやく烟はつりにもきえぬばりりの世を過もらむ",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "み佛のみ名となへつゝ思ふ哉我身もいつの世にうよばれむ",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "木枯比音をまくらにきゝもてヽ夢あたさけき閨のうづみ火",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "埋火北ほたるばろりを集めつゝ學びおくれし身を悔むかな",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "埋火比たえたるをつぐ炭いあれど起しグたしや廢れたる道",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "今日も又みぞれふる寺寒けれびゐろりの榾火さき暮しつゝ",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "よあはまの濱風いうにさむりらむこの綿子きて埋火によれ",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "これとても佛の心あるものをいづくにとてク鬼やらひもる",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "ひとゝせの夢も今宵いさめはてゝねられぬ床に夜を守る哉",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "さしてゆく方もあらじを一年の今宵ばりりと急ぐなるらむ",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "老せじと思ひこし路の白雪もかしらのものとなりにける哉",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "いづれの世何れの人クいひ出て戀といふ事をしへそめけむ",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "れいの音りねの響もきゝわりぬ耳い戀にやつぶれたるらむ",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "夕ぐれをたそうれ時ときゝしクど我見し人い違はざりろり",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "中々に今いはつ瀨の山れろしはゆしりりしも嬉しクりりり",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "朝日影さしてもあらぬ旅なれど別るとなれが悲しろりろり",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "さび衣たつ日とおれバ人なみに杖よ笠よといひさとぎつゝ",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "故〓の戀しとまでいあらねども旅ねとなれバ物ぞセびしき",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "みち北く比安達グ原あきてミれど人おい鬼もなき世えりり",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "いける世おとひもとはれもしてましと思ふぞ今日の手向えりる",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "一しきり世おなる神比おとろへてきごゆるものい峰壮松風",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "吉野山花い數あもあらぬまでかぐはしき跡を見つる今日哉",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "うづもれし岩間づたひ北苔〓水音なき音比たりくきこゆる",
   "kana": "",
   "speaker": "",
   "page": 70,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "81",
   "text": "あはれ其玄づくばかりも古へはひとの心をくむよしもグを",
   "kana": "",
   "speaker": "",
   "page": 70,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "82",
   "text": "宿せるい一夜なきども吳竹北ひとよおいあらぬ契なるべし",
   "kana": "",
   "speaker": "",
   "page": 70,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "83",
   "text": "もろこしの山れあなと比夕日りダ千年此後もさすひりり哉",
   "kana": "",
   "speaker": "",
   "page": 70,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "84",
   "text": "けふい野邊あすい山邊と浮雲の行方も知らぬ旅ごろもかな",
   "kana": "",
   "speaker": "",
   "page": 70,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "85",
   "text": "ゆきくれて宿をうりねの艸まくら結ぶも世々の契なるらむ",
   "kana": "",
   "speaker": "",
   "page": 70,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "86",
   "text": "世の中をそらふく風にまかもれバ心にりゝるうき雲もなし",
   "kana": "",
   "speaker": "",
   "page": 70,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "87",
   "text": "幽りなる昔グたりを燈火にクゝゆいだももはづりしの世や",
   "kana": "",
   "speaker": "",
   "page": 70,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "88",
   "text": "とりいだもわづらひだにもなきものい我轉寢のひぢ枕あな",
   "kana": "",
   "speaker": "",
   "page": 70,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "89",
   "text": "これもまた已グものとて犬比尾もふりもて難き習なりりり",
   "kana": "",
   "speaker": "",
   "page": 70,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "90",
   "text": "鼠とるゆめや見るらむ猫の子のねぶれるうちも貪瞋癡にて",
   "kana": "",
   "speaker": "",
   "page": 70,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "91",
   "text": "さもさでのさても危き世おりといもれてや魚の思ひ知る覽",
   "kana": "",
   "speaker": "",
   "page": 70,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "92",
   "text": "稻むしろ一もぢぬきて賤の男グ束ねし髮の世にかろげむる",
   "kana": "",
   "speaker": "",
   "page": 70,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "93",
   "text": "齡のみまもみの鏡年をへてうつれがりはるわらもグたりを",
   "kana": "",
   "speaker": "",
   "page": 70,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "94",
   "text": "見るふしもあらで我よいもぎにりり何を學びの窓のくれ竹",
   "kana": "",
   "speaker": "",
   "page": 70,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "95",
   "text": "何かせむかちえたりとて蝸牛つのふりたつる程もおき世に",
   "kana": "",
   "speaker": "",
   "page": 70,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "96",
   "text": "童にもとはでいあらじ夏草の道まどはしき野邊のやちまた",
   "kana": "",
   "speaker": "",
   "page": 70,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "97",
   "text": "一しきりふるから小野の村時雨月にい露もさはらざりけり",
   "kana": "",
   "speaker": "",
   "page": 70,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "98",
   "text": "ありぞまふうちいよせても岩グ根みおのも碎けて歸る白波",
   "kana": "",
   "speaker": "",
   "page": 70,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "99",
   "text": "み佛のみ名かぞへつゝ出る息いる息またぬ世をもごさばや",
   "kana": "",
   "speaker": "",
   "page": 70,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "100",
   "text": "我そでの玉とひろひてつゝまばやうちつクられし石も瓦も",
   "kana": "",
   "speaker": "",
   "page": 70,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "101",
   "text": "法北海よしいりばりり深くとも汲みほも迄い汲まむとぞ思ふ",
   "kana": "",
   "speaker": "",
   "page": 70,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "102",
   "text": "音もなくもグたも見えぞ我法いむなしき空に風わたるをり",
   "kana": "",
   "speaker": "",
   "page": 71,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "103",
   "text": "花園い名のみなりけり此頃いくち木グちなる志賀のふる里",
   "kana": "",
   "speaker": "",
   "page": 71,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "104",
   "text": "をれてこぐ難波堀江のあま小舟あしからざるい少なかりけり",
   "kana": "",
   "speaker": "",
   "page": 71,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "105",
   "text": "朝風に峯の木のはのちるを見れバ一葉〓〓に悟りなりけり",
   "kana": "",
   "speaker": "",
   "page": 71,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "106",
   "text": "迷ひゆく閣路のもゑのはてををみはてなく照も光をるらむ",
   "kana": "",
   "speaker": "",
   "page": 71,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "107",
   "text": "ふみわりてゆくに障りぞおりりろるもゆる炎もむもぶ氷も",
   "kana": "",
   "speaker": "",
   "page": 71,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "108",
   "text": "妻ごひにつりれてねむる唐猫の戀にやせたる夢や見るらむ",
   "kana": "",
   "speaker": "",
   "page": 71,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "109",
   "text": "いたづらに音ばりりして村蘆北葉末にとまる風むろりろり",
   "kana": "",
   "speaker": "",
   "page": 71,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "110",
   "text": "夢比世い見をども見れどはてぞおきあはもさむべき曉もグな",
   "kana": "",
   "speaker": "",
   "page": 71,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "111",
   "text": "いたづらに枕をてらも燈火も思へバひとのあぶらおりけり",
   "kana": "",
   "speaker": "",
   "page": 71,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "112",
   "text": "曉のかぜにほのめくともし火のけぬばクりなるわグ命のな",
   "kana": "",
   "speaker": "",
   "page": 71,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "113",
   "text": "入相の鐘つく〓〓と思ふにも後の世いうにならむときらむ",
   "kana": "",
   "speaker": "",
   "page": 71,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "114",
   "text": "ひれふるもいそグしどんいろくづ比浮藻の下も浮世なるらむ",
   "kana": "",
   "speaker": "",
   "page": 71,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "115",
   "text": "あみだぶとよべバ答へてみ佛い枕のうへにあらはれにけり",
   "kana": "",
   "speaker": "",
   "page": 71,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "116",
   "text": "老といへバ名をだに我もいとひしを我身のものと成ふりる哉",
   "kana": "",
   "speaker": "",
   "page": 71,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "117",
   "text": "老にきと誰にかこた·むいたづらに過しも己グ月日なりりり",
   "kana": "",
   "speaker": "",
   "page": 71,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "118",
   "text": "古へのつるのはやしの思ひさへ思ひ知らるゝこのゆふべ哉",
   "kana": "",
   "speaker": "",
   "page": 72,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "119",
   "text": "かしこにもこゝにも闇や重ぬらむきえにきえにし法の燈火",
   "kana": "",
   "speaker": "",
   "page": 72,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "120",
   "text": "おしなべてとまりはてざる世なれどもあまりに早くちる木葉哉",
   "kana": "",
   "speaker": "",
   "page": 72,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "121",
   "text": "はうなさい同じことなる人の身を人の身とのみ思ひりる哉",
   "kana": "",
   "speaker": "",
   "page": 72,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "122",
   "text": "骨となりて後に思へバやれ扇あふられし世い夢にぞ有りる",
   "kana": "",
   "speaker": "",
   "page": 72,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "123",
   "text": "思をバかけし比きばのいよもだれゆらめく物い心なるらむ",
   "kana": "",
   "speaker": "",
   "page": 72,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "124",
   "text": "あはれその蓬グ島にゆきてみむ死をぬ藥のありとこそきり",
   "kana": "",
   "speaker": "",
   "page": 72,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "125",
   "text": "もとぢ葉のそれにいあらで紅におつるい袖のなみざえりり",
   "kana": "",
   "speaker": "",
   "page": 72,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "126",
   "text": "はりなしと思ふもはうな仇し野にれくいあしゝの露ばろりクは",
   "kana": "",
   "speaker": "",
   "page": 72,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "127",
   "text": "ふく風おまりもるものいかきなでし寢くたれ髪の亂えけり",
   "kana": "",
   "speaker": "",
   "page": 72,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "128",
   "text": "あはれ誰むもびし夢のはてならむ尾花グ末にあき風ぞふく",
   "kana": "",
   "speaker": "",
   "page": 72,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "129",
   "text": "いづくにり身をバおりまし山里も枕にさはるまつ風のこゑ",
   "kana": "",
   "speaker": "",
   "page": 73,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "130",
   "text": "いたづらにふりし頭の白ゆきも罪もむくいもきゆるらふ哉",
   "kana": "",
   "speaker": "",
   "page": 73,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "131",
   "text": "これもまた一ふしなれど吳竹の高きい風にをれやもきもの",
   "kana": "",
   "speaker": "",
   "page": 73,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "132",
   "text": "みちのくいそとの濱風吹くときく吹きなびりせよ法の民草",
   "kana": "",
   "speaker": "",
   "page": 73,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "133",
   "text": "武藏野の草の葉末の露の世にいづれさきだちいづれかくれむ",
   "kana": "",
   "speaker": "",
   "page": 73,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "134",
   "text": "人の子も我子と思ふこゝろあそやグて佛のあゝろなりれれ",
   "kana": "",
   "speaker": "",
   "page": 73,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "135",
   "text": "塵の世のはるよ何せむ庭くさもあらかむばしな法の花ぞの",
   "kana": "",
   "speaker": "",
   "page": 73,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "136",
   "text": "見ぬ聞うぬ人もある世に御佛を思ふらまゝにをグみつる哉",
   "kana": "",
   "speaker": "",
   "page": 73,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "137",
   "text": "守りませ守りまもらむ君グ代の動かざる世も動かざるべく",
   "kana": "",
   "speaker": "",
   "page": 73,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "138",
   "text": "世のああをかけはなれたる筧よりたえき流るゝ岩〓水あな",
   "kana": "",
   "speaker": "",
   "page": 73,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "139",
   "text": "もむといふ名もこと〓〓し隅田川よどむばかりを波の上の月",
   "kana": "",
   "speaker": "",
   "page": 73,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "140",
   "text": "きえのこる露の身一つおうむあい余るばかりの庵をりけり",
   "kana": "",
   "speaker": "",
   "page": 73,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "141",
   "text": "山ざるのかほより赤き衣着て人にみえむもはづのしきのお",
   "kana": "",
   "speaker": "",
   "page": 73,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "142",
   "text": "老松の木末ばありいいまもおほむかしの風の宿りなるらむ",
   "kana": "",
   "speaker": "",
   "page": 74,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "143",
   "text": "我法のさとりにいあらで位山比ぼるいやぶて下るなりなり",
   "kana": "",
   "speaker": "",
   "page": 74,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "144",
   "text": "極樂い枕べちかくありおぶらおどゆめにだもみられざるらむ",
   "kana": "",
   "speaker": "",
   "page": 74,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "145",
   "text": "みほとけのみあとつくるもいにしへのかしこきみあとふみ",
   "kana": "",
   "speaker": "",
   "page": 74,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "146",
   "text": "にけらしもあふぎけらしも",
   "kana": "",
   "speaker": "",
   "page": 74,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "147",
   "text": "そのみあと見るひとごとにちよろづのつみもきえぬと聞く",
   "kana": "",
   "speaker": "",
   "page": 74,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "148",
   "text": "グうきしさみるがうれしさ",
   "kana": "",
   "speaker": "",
   "page": 74,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "149",
   "text": "セグ庵にたえぞゆきかふ母と子の犬ぞありけるあしたにい",
   "kana": "",
   "speaker": "",
   "page": 74,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "150",
   "text": "庭に乳のみて夕べにハ門にねむりてあ出日頃をれにし物を",
   "kana": "",
   "speaker": "",
   "page": 74,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "151",
   "text": "前の世の報いし物りうつし世比わざはひなるりゆくりむく",
   "kana": "",
   "speaker": "",
   "page": 74,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "152",
   "text": "昨日の朝〓犬とりに打殺されて母と子の玄あばねまでもを",
   "kana": "",
   "speaker": "",
   "page": 74,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "153",
   "text": "しと聞くあないたましとそとばたて施食供しておもへらく",
   "kana": "",
   "speaker": "",
   "page": 74,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "154",
   "text": "身を毛衣にうゝまれて形を橫に生れきて吠ゆる外にハ聲も",
   "kana": "",
   "speaker": "",
   "page": 74,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "155",
   "text": "おくあさるやうにいわざもなく狗子佛性い名のみにて顯現",
   "kana": "",
   "speaker": "",
   "page": 74,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "156",
   "text": "後の世にけふ殺されし其犬い人とうまれて後の世ゐ今日殺",
   "kana": "",
   "speaker": "",
   "page": 74,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "157",
   "text": "しさる其人ハ犬と生れて後の世い又殺すらむまた殺されむ",
   "kana": "",
   "speaker": "",
   "page": 74,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "158",
   "text": "我も亦をしとこそおもへをしと思ふ命いおおじ命ならもや",
   "kana": "",
   "speaker": "",
   "page": 74,
   "pid": "993390",
   "form": "短歌",
   "genre": ""
  }
 ],
